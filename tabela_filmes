CREATE TABLE utilizadores(
  id_utilizador INT PRIMARY KEY,
  nome_utilizador VARCHAR(30),
  email VARCHAR(30),
  data_adesao VARCHAR(10)
  );
  
  
  CREATE TABLE filmes(
    id_filme INT PRIMARY KEY,
    titulo TEXT,
    genero TEXT,
    ano_lancamento VARCHAR(4),
    classificacao_etaria VARCHAR(2)
    );
  
  
  	CREATE TABLE historico_visualizacao(
      id_historico INT PRIMARY KEY,
      id_utilizador INT,
      id_filme INT,
      data_que_assistiu CHAR(10),
      dispositivo TEXT(20),
      FOREIGN KEY (id_utilizador) REFERENCES utilizadores(id_utilizador),
      FOREIGN KEY (id_filme) REFERENCES filmes(id_filme)
      );
      
      
